# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.env
backend/.pytest_cache/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local    
frontend/.npm
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Documents (Application Storage)
# We ignore everything inside documents/ except a .gitkeep if you want the folder to exist
documents/*
!documents/.gitkeep

# IDEs and OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
